// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "Workspace",
    "bindings": {
      // "shift shift": "file_finder::Toggle"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "escape": "vim::HelixNormalAfter"
    }
  },
  {
    "context": "Editor && showing_completions",
    "bindings": {
      "ctrl-shift-alt-escape": "vim::HelixNormalAfter",
      "ctrl-shift-escape": "editor::Cancel",
      "escape": [
        "workspace::SendKeystrokes",
        "ctrl-shift-alt-escape ctrl-shift-escape"
      ]
    }
  },
  {
    "context": "Editor && !showing_completions && vim_mode != insert",
    "bindings": {
      "escape": "vim::HelixNormalAfter",
      "# a v": "vim::SwitchToNormalMode",
      "# c s": "vim::PushChangeSurrounds",
      "# d s": "vim::PushDeleteSurrounds",
      "# y s": "vim::PushAddSurrounds",
      "m r": ["workspace::SendKeystrokes", "# a v # c s"],
      "m d": ["workspace::SendKeystrokes", "# a v # d s"],
      "m s": ["workspace::SendKeystrokes", "b e v # y s"],
      "space t": "terminal_panel::ToggleFocus"
    }
  },
  {
    "context": "!Editor && !Terminal",
    "bindings": {
      "space f": "file_finder::Toggle",
      "space t": "terminal_panel::ToggleFocus",
      ":": "command_palette::Toggle"
    }
  },
  {
    "context": "!Editor && Terminal",
    "bindings": {
      "space f": "file_finder::Toggle",
      "space t": "workspace::ToggleBottomDock"
    }
  }
]
